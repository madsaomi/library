# ==========================================
# RAQAMLI KUTUBXONA - ENVIRONMENT VARIABLES
# ==========================================

# --- BACKEND (DJANGO) SETTINGS ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,http://localhost:8000

# --- DATABASE ---
# Railway provides DATABASE_URL automatically. For local dev:
# DATABASE_URL=postgres://kutubxona:kutubxona@localhost:5432/kutubxona

# --- CELERY (Background Tasks) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CHANNELS (WebSocket) ---
# In-memory by default. Set to channels_redis.core.RedisChannelLayer for production.
# CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
# CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/1

# --- SENTRY (Error Monitoring) ---
# SENTRY_DSN=https://key@o123.ingest.sentry.io/project
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- WEB PUSH (Browser Notifications) ---
# Generate keys: python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@kutubxona.uz

# --- EMAIL ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@email.com
# EMAIL_HOST_PASSWORD=your-password
# DEFAULT_FROM_EMAIL=noreply@kutubxona.uz
